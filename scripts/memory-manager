#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MEMORY_DIR_DEFAULT="${REPO_ROOT}/memory"

export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"

# Pick the first interpreter that can ACTUALLY import the dependencies, rather
# than the first one that merely exists. A deployment without a venv (the box
# runs the bot from a Nix python env) used to fall through to the bare system
# python3 and die with `ModuleNotFoundError: No module named 'yaml'` — an
# interpreter-selection failure wearing a dependency error's clothes.
#
# Order: explicit override, repo venv, everything named python3/python on PATH.
CANDIDATES=()
[[ -n "${ILA_PYTHON:-}" ]] && CANDIDATES+=("${ILA_PYTHON}")
CANDIDATES+=("${REPO_ROOT}/venv/bin/python3" "${REPO_ROOT}/venv/bin/python")
while IFS= read -r found; do
  [[ -n "$found" ]] && CANDIDATES+=("$found")
done < <(type -aP python3 python 2>/dev/null || true)

PYTHON_BIN=""
for candidate in "${CANDIDATES[@]}"; do
  [[ -x "$candidate" ]] || continue
  if "$candidate" -c "import yaml" >/dev/null 2>&1; then
    PYTHON_BIN="$candidate"
    break
  fi
done

if [[ -z "${PYTHON_BIN}" ]]; then
  {
    echo "ERROR: no Python interpreter here can import 'yaml'. Tried:"
    for candidate in "${CANDIDATES[@]}"; do
      if [[ -x "$candidate" ]]; then echo "  - $candidate (missing deps)"
      else echo "  - $candidate (not executable)"; fi
    done
    echo
    echo "  Fix:  cd ${REPO_ROOT} && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt"
    echo "  Or:   set ILA_PYTHON to an interpreter that already has them."
    echo
    echo "(This tool only reads and writes files under memory/ — it needs no bot"
    echo " token, no .env and no network. It just needs the Python dependencies.)"
  } >&2
  exit 1
fi

if [[ $# -gt 0 && "$1" == "--memory-dir" ]]; then
  exec "${PYTHON_BIN}" -m src.memory_tool "$@"
fi

exec "${PYTHON_BIN}" -m src.memory_tool --memory-dir "${MEMORY_DIR_DEFAULT}" "$@"
