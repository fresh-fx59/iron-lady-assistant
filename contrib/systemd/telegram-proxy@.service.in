[Unit]
Description=iron-lady telegram proxy (account: %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=@ENVFILE@
Environment=PYTHONUNBUFFERED=1
Environment=ILA_PROXY_ACCOUNT=%i
ExecStart=@PYTHON@ -m src.telegram_proxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
